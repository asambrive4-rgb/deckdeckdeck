<UserControl x:Class="DeckDeckDeck.App.Views.CategoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DeckDeckDeck.App.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="2,0,2,8"
                Padding="10,6"
                CornerRadius="12"
                BorderThickness="1.5"
                BorderBrush="{StaticResource Deck.Brush.Line.Soft}"
                Background="{StaticResource Deck.Brush.Background.Surface}"
                Visibility="{Binding ShowAndroidConnectionSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Deck.Brush.Text.Secondary}"
                           Text="{Binding AndroidConnectionSummaryText}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding AndroidConnectionSummaryText}" />

                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="8,2"
                        MinHeight="22"
                        FontSize="11"
                        Command="{Binding RefreshAndroidConnectionCommand}"
                        Style="{StaticResource Deck.SecondaryButtonStyle}"
                        Content="새로고침 ↻" />
            </Grid>
        </Border>

        <views:NumpadGridView Grid.Row="1"
                              DataContext="{Binding NumpadGrid}" />
    </Grid>
</UserControl>
