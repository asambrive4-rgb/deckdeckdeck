<Window x:Class="DeckDeckDeck.App.Views.TimerTimePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="타이머 시간 선택" Height="300" Width="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="#FFF7D1"
            BorderBrush="#A77743"
            BorderThickness="2"
            CornerRadius="16"
            Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="4" Direction="270" Color="#50000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0"
                       Text="⏱️ 타이머 시간 선택"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#A77743"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

            <!-- Time Inputs -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Vertical" Margin="5">
                    <TextBlock Text="분 (Min)" FontSize="12" Foreground="#A77743" HorizontalAlignment="Center"/>
                    <TextBox Text="{Binding Minutes, UpdateSourceTrigger=PropertyChanged}"
                             Width="70" Height="40" FontSize="20" FontWeight="Bold"
                             TextAlignment="Center" VerticalContentAlignment="Center"
                             Background="#FFFFFF" Foreground="#A77743" BorderBrush="#FFB15E" BorderThickness="1.5"/>
                </StackPanel>

                <TextBlock Text=":" FontSize="24" FontWeight="Bold" Foreground="#A77743" VerticalAlignment="Center" Margin="5,15,5,0"/>

                <StackPanel Orientation="Vertical" Margin="5">
                    <TextBlock Text="초 (Sec)" FontSize="12" Foreground="#A77743" HorizontalAlignment="Center"/>
                    <TextBox Text="{Binding Seconds, UpdateSourceTrigger=PropertyChanged}"
                             Width="70" Height="40" FontSize="20" FontWeight="Bold"
                             TextAlignment="Center" VerticalContentAlignment="Center"
                             Background="#FFFFFF" Foreground="#A77743" BorderBrush="#FFB15E" BorderThickness="1.5"/>
                </StackPanel>
            </StackPanel>

            <!-- Presets -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,15">
                <Button Content="30초" Command="{Binding SelectPresetCommand}" CommandParameter="30" Margin="3" Padding="8,4" Background="#FFB15E" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="1분" Command="{Binding SelectPresetCommand}" CommandParameter="60" Margin="3" Padding="8,4" Background="#FFB15E" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="3분" Command="{Binding SelectPresetCommand}" CommandParameter="180" Margin="3" Padding="8,4" Background="#FFB15E" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="5분" Command="{Binding SelectPresetCommand}" CommandParameter="300" Margin="3" Padding="8,4" Background="#FFB15E" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="10분" Command="{Binding SelectPresetCommand}" CommandParameter="600" Margin="3" Padding="8,4" Background="#FFB15E" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"/>
            </StackPanel>

            <!-- Action Buttons -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="취소" Command="{Binding CancelCommand}"
                        Height="36" Background="#A77743" Foreground="#FFF7D1" FontWeight="Bold" BorderThickness="0"/>
                <Button Grid.Column="2" Content="타이머 시작" Command="{Binding ConfirmCommand}" IsEnabled="{Binding IsValidDuration}"
                        Height="36" Background="#FFB15E" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
