<Window x:Class="DeckDeckDeck.App.Views.TimerTimePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="타이머 시간 선택" Height="300" Width="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource Deck.Font.App}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="NoResize">

    <Border Background="{StaticResource Deck.Brush.Background.App}"
            BorderBrush="{StaticResource Deck.Brush.Line.Soft}"
            BorderThickness="{StaticResource Deck.Thickness.Border}"
            CornerRadius="20"
            Padding="22">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0"
                       Text="⏱️ 타이머 시간 선택"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Deck.Brush.Text.Primary}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

            <!-- Time Inputs -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Vertical" Margin="5">
                    <TextBlock Text="분 (Min)" FontSize="12" Foreground="{StaticResource Deck.Brush.Text.Secondary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Minutes, UpdateSourceTrigger=PropertyChanged}"
                             Width="72" Height="42" FontSize="20" FontWeight="SemiBold"
                             TextAlignment="Center" VerticalContentAlignment="Center"
                             Style="{StaticResource Deck.TextBoxStyle}"
                             BorderBrush="{StaticResource Deck.Brush.Line.Strong}" />
                </StackPanel>

                <TextBlock Text=":" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Deck.Brush.Text.Secondary}" VerticalAlignment="Center" Margin="6,16,6,0"/>

                <StackPanel Orientation="Vertical" Margin="5">
                    <TextBlock Text="초 (Sec)" FontSize="12" Foreground="{StaticResource Deck.Brush.Text.Secondary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Seconds, UpdateSourceTrigger=PropertyChanged}"
                             Width="72" Height="42" FontSize="20" FontWeight="SemiBold"
                             TextAlignment="Center" VerticalContentAlignment="Center"
                             Style="{StaticResource Deck.TextBoxStyle}"
                             BorderBrush="{StaticResource Deck.Brush.Line.Strong}" />
                </StackPanel>
            </StackPanel>

            <!-- Presets -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,18">
                <Button Content="30초" Command="{Binding SelectPresetCommand}" CommandParameter="30" Margin="3" MinHeight="28" Padding="10,4" FontSize="12" Style="{StaticResource Deck.SecondaryButtonStyle}" />
                <Button Content="1분" Command="{Binding SelectPresetCommand}" CommandParameter="60" Margin="3" MinHeight="28" Padding="10,4" FontSize="12" Style="{StaticResource Deck.SecondaryButtonStyle}" />
                <Button Content="3분" Command="{Binding SelectPresetCommand}" CommandParameter="180" Margin="3" MinHeight="28" Padding="10,4" FontSize="12" Style="{StaticResource Deck.SecondaryButtonStyle}" />
                <Button Content="5분" Command="{Binding SelectPresetCommand}" CommandParameter="300" Margin="3" MinHeight="28" Padding="10,4" FontSize="12" Style="{StaticResource Deck.SecondaryButtonStyle}" />
                <Button Content="10분" Command="{Binding SelectPresetCommand}" CommandParameter="600" Margin="3" MinHeight="28" Padding="10,4" FontSize="12" Style="{StaticResource Deck.SecondaryButtonStyle}" />
            </StackPanel>

            <!-- Action Buttons -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="취소" Command="{Binding CancelCommand}"
                        Height="36" Style="{StaticResource Deck.SecondaryButtonStyle}" />
                <Button Grid.Column="2" Content="타이머 시작" Command="{Binding ConfirmCommand}" IsEnabled="{Binding IsValidDuration}"
                        Height="36" Style="{StaticResource Deck.PrimaryButtonStyle}" />
            </Grid>
        </Grid>
    </Border>
</Window>
