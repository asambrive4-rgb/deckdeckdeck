<UserControl x:Class="DeckDeckDeck.App.Views.HotkeyEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:DeckDeckDeck.App.Views.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Deck.InfoPanelBorderStyle}"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Style="{StaticResource Deck.FieldGroupStyle}">
                            <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="핫키 이름" />
                            <TextBox Style="{StaticResource Deck.TextBoxStyle}"
                                     Text="{Binding HotkeyTitle, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Deck.FieldGroupSpacedStyle}">
                            <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="전역 핫키" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Command="{Binding BeginHotkeyCaptureCommand}"
                                        PreviewKeyDown="HotkeyInputButton_PreviewKeyDown"
                                        Style="{StaticResource Deck.SecondaryButtonStyle}">
                                    <TextBlock Text="{Binding HotkeyDisplayText}"
                                               TextAlignment="Center" />
                                </Button>
                                <Button Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Command="{Binding ClearHotkeyCommand}"
                                        Style="{StaticResource Deck.ImageActionButtonStyle}"
                                        Content="초기화" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Style="{StaticResource Deck.FieldGroupSpacedStyle}">
                            <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="실행 타입" />
                            <UniformGrid Columns="3" Margin="-3,0,-3,-3">
                                <RadioButton Content="붙여넣기"
                                             GroupName="HotkeyActionType"
                                             IsChecked="{Binding IsPasteAction, Mode=TwoWay}"
                                             Style="{StaticResource Deck.ActionTypeToggleStyle}" />
                                <RadioButton Content="열기 · 실행"
                                             GroupName="HotkeyActionType"
                                             IsChecked="{Binding IsOpenLaunchAction, Mode=TwoWay}"
                                             Style="{StaticResource Deck.ActionTypeToggleStyle}" />
                                <RadioButton Content="미디어 제어"
                                             GroupName="HotkeyActionType"
                                             IsChecked="{Binding IsMediaAction, Mode=TwoWay}"
                                             Style="{StaticResource Deck.ActionTypeToggleStyle}" />
                                <RadioButton Content="시스템 · 편의"
                                             GroupName="HotkeyActionType"
                                             IsChecked="{Binding IsSystemUtilityAction, Mode=TwoWay}"
                                             Style="{StaticResource Deck.ActionTypeToggleStyle}" />
                                <RadioButton Content="터미널"
                                             GroupName="HotkeyActionType"
                                             IsChecked="{Binding IsTerminalAction, Mode=TwoWay}"
                                             Style="{StaticResource Deck.ActionTypeToggleStyle}" />
                                <RadioButton Content="Android"
                                             GroupName="HotkeyActionType"
                                             IsChecked="{Binding IsAndroidAction, Mode=TwoWay}"
                                             Style="{StaticResource Deck.ActionTypeToggleStyle}" />
                            </UniformGrid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Style="{StaticResource Deck.InfoPanelBorderStyle}"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <!-- 1. 붙여넣기 (문구 붙여넣기 / 파일 붙여넣기) -->
                        <StackPanel Style="{StaticResource Deck.FieldGroupStyle}"
                                    Visibility="{Binding IsPasteAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="붙여넣기 유형" />
                            <UniformGrid Columns="2" Margin="-3,0,-3,10">
                                <RadioButton Content="문구 붙여넣기"
                                             GroupName="HotkeyPasteSubMode"
                                             IsChecked="{Binding IsPasteTextMode, Mode=TwoWay}"
                                             Style="{StaticResource Deck.SubModeToggleStyle}" />
                                <RadioButton Content="파일 붙여넣기"
                                             GroupName="HotkeyPasteSubMode"
                                             IsChecked="{Binding IsFilePasteMode, Mode=TwoWay}"
                                             Style="{StaticResource Deck.SubModeToggleStyle}" />
                            </UniformGrid>

                            <StackPanel Visibility="{Binding IsPasteTextMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                           Text="붙여넣을 문구" />
                                <TextBox MinHeight="90"
                                         MaxHeight="220"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         Style="{StaticResource Deck.TextBoxStyle}"
                                         Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                                <TextBlock Margin="0,12,0,6"
                                           Style="{StaticResource Deck.FieldLabelTextStyle}"
                                           Text="붙여넣기 방식" />
                                <ComboBox ItemsSource="{Binding PasteShortcutModeOptions}"
                                          SelectedValue="{Binding PasteShortcutMode, Mode=TwoWay}"
                                          SelectedValuePath="Mode"
                                          DisplayMemberPath="Label"
                                          Style="{StaticResource Deck.ComboBoxStyle}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsFilePasteMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                           Text="{Binding FilePathLabel}" />
                                <TextBox Style="{StaticResource Deck.TextBoxStyle}"
                                         Text="{Binding LaunchPath, UpdateSourceTrigger=PropertyChanged}" />
                                <WrapPanel Margin="0,8,0,-6">
                                    <Button Margin="0,0,8,6"
                                            Command="{Binding ChooseLaunchFileCommand}"
                                            Style="{StaticResource Deck.ImageActionButtonStyle}"
                                            Content="{Binding FilePickerButtonText}" />
                                </WrapPanel>
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{StaticResource Deck.Brush.Text.Secondary}"
                                           Text="직전에 사용하던 탐색기 또는 파일 붙여넣기를 지원하는 앱에 전달합니다."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 2. 열기 · 실행 (파일·폴더·앱 / 웹 주소 URL) -->
                        <StackPanel Style="{StaticResource Deck.FieldGroupStyle}"
                                    Visibility="{Binding IsOpenLaunchAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="실행 대상" />
                            <UniformGrid Columns="2" Margin="-3,0,-3,10">
                                <RadioButton Content="파일 · 폴더 · 앱"
                                             GroupName="HotkeyOpenLaunchSubMode"
                                             IsChecked="{Binding IsFileLaunchMode, Mode=TwoWay}"
                                             Style="{StaticResource Deck.SubModeToggleStyle}" />
                                <RadioButton Content="웹 주소 (URL)"
                                             GroupName="HotkeyOpenLaunchSubMode"
                                             IsChecked="{Binding IsLaunchUrlMode, Mode=TwoWay}"
                                             Style="{StaticResource Deck.SubModeToggleStyle}" />
                            </UniformGrid>

                            <StackPanel Visibility="{Binding IsFileLaunchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                           Text="{Binding FilePathLabel}" />
                                <TextBox Style="{StaticResource Deck.TextBoxStyle}"
                                         Text="{Binding LaunchPath, UpdateSourceTrigger=PropertyChanged}" />
                                <WrapPanel Margin="0,8,0,-6">
                                    <Button Margin="0,0,8,6"
                                            Command="{Binding ChooseLaunchFileCommand}"
                                            Style="{StaticResource Deck.ImageActionButtonStyle}"
                                            Content="{Binding FilePickerButtonText}" />
                                    <Button Margin="0,0,8,6"
                                            Command="{Binding ChooseLaunchFolderCommand}"
                                            Style="{StaticResource Deck.ImageActionButtonStyle}"
                                            Content="폴더 선택" />
                                    <Button Margin="0,0,8,6"
                                            Command="{Binding ChooseInstalledAppCommand}"
                                            Style="{StaticResource Deck.ImageActionButtonStyle}"
                                            Content="설치된 앱 선택" />
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsLaunchUrlMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                           Text="열 웹페이지 주소" />
                                <TextBox Style="{StaticResource Deck.TextBoxStyle}"
                                         Text="{Binding LaunchUrl, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 3. 미디어 제어 -->
                        <StackPanel Style="{StaticResource Deck.FieldGroupStyle}"
                                    Visibility="{Binding IsMediaAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="제어 대상" />
                            <ComboBox ItemsSource="{Binding MediaProviderOptions}"
                                      SelectedValue="{Binding SelectedMediaProvider, Mode=TwoWay}"
                                      SelectedValuePath="Provider"
                                      DisplayMemberPath="Label"
                                      Style="{StaticResource Deck.ComboBoxStyle}" />
                            <TextBlock Margin="0,10,0,6"
                                       Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="미디어 명령" />
                            <ComboBox ItemsSource="{Binding MediaCommandOptions}"
                                      SelectedValue="{Binding SelectedMediaCommand, Mode=TwoWay}"
                                      SelectedValuePath="Command"
                                      DisplayMemberPath="Label"
                                      Style="{StaticResource Deck.ComboBoxStyle}" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{StaticResource Deck.Brush.Text.Secondary}"
                                       Text="{Binding SpotifyMediaConnectionNotice}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding ShowSpotifyMediaConnectionNotice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- 4. 시스템 · 편의 (화면 끄기 / 블루투스, 타이머는 슬롯 전용) -->
                        <StackPanel Style="{StaticResource Deck.FieldGroupStyle}"
                                    Visibility="{Binding IsSystemUtilityAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="기능 선택" />
                            <UniformGrid Columns="2" Margin="-3,0,-3,10">
                                <RadioButton Content="화면 끄기"
                                             GroupName="HotkeySystemSubMode"
                                             IsChecked="{Binding IsTurnOffDisplayPresetActive, Mode=TwoWay}"
                                             Style="{StaticResource Deck.SubModeToggleStyle}" />
                                <RadioButton Content="블루투스"
                                             GroupName="HotkeySystemSubMode"
                                             IsChecked="{Binding IsBluetoothPresetActive, Mode=TwoWay}"
                                             Style="{StaticResource Deck.SubModeToggleStyle}" />
                            </UniformGrid>

                            <Border Margin="0,2,0,4"
                                    Padding="12,10"
                                    CornerRadius="12"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource Deck.Brush.Line.Soft}"
                                    Background="{StaticResource Deck.Brush.Background.Surface}"
                                    Visibility="{Binding IsTurnOffDisplayPresetActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                        <Path DockPanel.Dock="Left"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Data="{StaticResource Deck.Geometry.Monitor}"
                                              Stroke="{StaticResource Deck.Brush.Brand.Accent}"
                                              StrokeThickness="1.5"
                                              Margin="0,0,6,0"
                                              VerticalAlignment="Center"/>
                                        <TextBlock FontWeight="SemiBold"
                                                   FontSize="12.5"
                                                   Foreground="{StaticResource Deck.Brush.Text.Primary}"
                                                   TextWrapping="Wrap"
                                                   Text="화면 끄기 모드가 적용되었습니다" />
                                    </DockPanel>
                                    <TextBlock Margin="0,2,0,2"
                                               FontSize="11.5"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource Deck.Brush.Text.Secondary}"
                                               Text="• 실행 시 앱 창이 즉시 닫히며 모니터 화면만 꺼집니다." />
                                    <TextBlock Margin="0,2,0,2"
                                               FontSize="11.5"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource Deck.Brush.Text.Secondary}"
                                               Text="• PC 본체와 핫스팟, Wi-Fi 및 백그라운드 작업은 유지됩니다." />
                                    <TextBlock Margin="0,2,0,6"
                                               FontSize="11.5"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource Deck.Brush.Text.Secondary}"
                                               Text="• 마우스를 움직이거나 키를 누르면 화면이 다시 켜집니다." />
                                    <Button Command="{Binding ToggleAdvancedTerminalSettingsCommand}"
                                            HorizontalAlignment="Left"
                                            Padding="10,4"
                                            MinHeight="28"
                                            Width="Auto"
                                            FontSize="11.5"
                                            Style="{StaticResource Deck.SecondaryButtonStyle}"
                                            Content="고급 설정 열기/닫기 ⌵" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,2,0,4"
                                    Style="{StaticResource Deck.InfoPanelBorderStyle}"
                                    Visibility="{Binding IsBluetoothPresetActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{StaticResource Deck.Brush.Text.Primary}"
                                               Text="블루투스 오디오 빠른 연결/해제"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,8"
                                               Foreground="{StaticResource Deck.Brush.Text.Secondary}"
                                               Text="외부 프로그램이나 관리자 권한 창 없이 윈도우 내장 블루투스 오디오를 즉시 연결하거나 해제합니다."
                                               TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                               Text="동작" />
                                    <UniformGrid Columns="2" Margin="-3,0,-3,8">
                                        <RadioButton Content="연결 (ON)"
                                                     IsChecked="{Binding IsBluetoothConnectAction, Mode=TwoWay}"
                                                     Style="{StaticResource Deck.SubModeToggleStyle}" />
                                        <RadioButton Content="연결 해제 (OFF)"
                                                     IsChecked="{Binding IsBluetoothDisconnectAction, Mode=TwoWay}"
                                                     Style="{StaticResource Deck.SubModeToggleStyle}" />
                                    </UniformGrid>
                                    <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                               Text="대상 기기 (MAC 주소 또는 기기 이름)" />
                                    <TextBox FontFamily="Cascadia Code, Consolas"
                                             Style="{StaticResource Deck.TextBoxStyle}"
                                             Text="{Binding BluetoothTarget, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="예: E4:92:82:82:D5:9B 또는 WH-1000XM5" />
                                    <WrapPanel Margin="0,8,0,-6">
                                        <Button Margin="0,0,8,6"
                                                Command="{Binding ChooseBluetoothDeviceCommand}"
                                                Style="{StaticResource Deck.ImageActionButtonStyle}"
                                                Content="페어링된 기기 선택" />
                                        <Button Margin="0,0,8,6"
                                                Command="{Binding ToggleAdvancedTerminalSettingsCommand}"
                                                Padding="10,4"
                                                MinHeight="28"
                                                Width="Auto"
                                                FontSize="11.5"
                                                Style="{StaticResource Deck.SecondaryButtonStyle}"
                                                Content="고급 설정 열기/닫기 ⌵" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 5. 터미널 안내 문구 -->
                        <TextBlock Margin="0,0,0,4"
                                   Foreground="{StaticResource Deck.Brush.Text.Secondary}"
                                   FontSize="12"
                                   Text="cmd 또는 PowerShell에서 실행할 명령을 직접 입력합니다."
                                   TextWrapping="Wrap"
                                   Visibility="{Binding IsTerminalAction, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <!-- 6. Android (무선 ADB 연결만 지원, 원격설치는 슬롯 전용) -->
                        <StackPanel Style="{StaticResource Deck.FieldGroupStyle}"
                                    Visibility="{Binding IsAndroidAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Style="{StaticResource Deck.InfoPanelBorderStyle}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{StaticResource Deck.Brush.Text.Primary}"
                                               Text="무선 디버깅 연결 (ADB Connect)" />
                                    <TextBlock Margin="0,4,0,8"
                                               Foreground="{StaticResource Deck.Brush.Text.Secondary}"
                                               Text="이 핫키에 쓸 기기 IP를 입력하세요. 저장 후 실행하면 포트만 입력하는 창이 뜨고 adb connect 합니다."
                                               TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                               Text="기기 IP 주소" />
                                    <TextBox FontFamily="Cascadia Code, Consolas"
                                             Style="{StaticResource Deck.TextBoxStyle}"
                                             Text="{Binding AdbDeviceIp, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="예: 10.42.17.83" />
                                    <Button Command="{Binding ToggleAdvancedTerminalSettingsCommand}"
                                            HorizontalAlignment="Left"
                                            Margin="0,8,0,0"
                                            Padding="10,4"
                                            MinHeight="28"
                                            Width="Auto"
                                            FontSize="11.5"
                                            Style="{StaticResource Deck.SecondaryButtonStyle}"
                                            Content="고급 설정 열기/닫기 ⌵" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 터미널 직접 입력 / 프리셋 고급 설정 -->
                        <StackPanel Margin="0,6,0,0"
                                    Visibility="{Binding ShowTerminalCommandEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="실행 셸" />
                            <ComboBox ItemsSource="{Binding TerminalShellOptions}"
                                      SelectedValue="{Binding SelectedTerminalShell, Mode=TwoWay}"
                                      SelectedValuePath="Shell"
                                      DisplayMemberPath="Label"
                                      Style="{StaticResource Deck.ComboBoxStyle}" />
                            <CheckBox Margin="0,10,0,0"
                                      Content="관리자 권한으로 실행"
                                      Style="{StaticResource Deck.CheckBoxStyle}"
                                      IsChecked="{Binding RunAsAdministrator}" />
                            <CheckBox Margin="0,8,0,0"
                                      Content="터미널 창으로 열기"
                                      Style="{StaticResource Deck.CheckBoxStyle}"
                                      IsChecked="{Binding OpenTerminalWindow}" />
                            <TextBlock Margin="0,12,0,0"
                                       Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="작업 폴더 (선택)" />
                            <TextBox Style="{StaticResource Deck.TextBoxStyle}"
                                     Text="{Binding TerminalWorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Margin="0,8,0,8"
                                    HorizontalAlignment="Left"
                                    Command="{Binding ChooseTerminalWorkingDirectoryCommand}"
                                    Style="{StaticResource Deck.ImageActionButtonStyle}"
                                    Content="폴더 선택" />
                            <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="터미널 명령" />
                            <TextBox MinHeight="80"
                                     MaxHeight="180"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     FontFamily="Cascadia Code, Consolas"
                                     Style="{StaticResource Deck.TextBoxStyle}"
                                     Text="{Binding TerminalCommand, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{StaticResource Deck.Brush.Text.Secondary}"
                                       Text="신뢰하는 명령만 저장하고 실행하세요. 명령을 비우면 작업 폴더에서 셸만 엽니다. 관리자 권한 실행 시 Windows 확인창이 표시될 수 있습니다."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Style="{StaticResource Deck.InfoPanelBorderStyle}"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Style="{StaticResource Deck.FieldGroupStyle}">
                            <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="설명" />
                            <TextBox MinHeight="46"
                                     MaxHeight="80"
                                     AcceptsReturn="True"
                                     Style="{StaticResource Deck.TextBoxStyle}"
                                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>

                        <CheckBox Margin="0,12,0,12"
                                  Content="이 핫키 사용"
                                  Style="{StaticResource Deck.CheckBoxStyle}"
                                  IsChecked="{Binding IsEnabled}" />

                        <StackPanel Style="{StaticResource Deck.FieldGroupStyle}">
                            <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="이미지" />
                            <DockPanel LastChildFill="False">
                                <Border AllowDrop="True"
                                        DragOver="ImageDropTarget_DragOver"
                                        Drop="ImageDropTarget_Drop"
                                        Style="{StaticResource Deck.ThumbnailFrameBorderStyle}">
                                    <Grid>
                                        <Image Source="{Binding ThumbnailPath, IsAsync=True, Converter={StaticResource Deck.CachedImageSourceConverter}, ConverterParameter=96}"
                                               IsHitTestVisible="False"
                                               Stretch="Uniform" />
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.45"
                                                    IsHitTestVisible="False"
                                                    Visibility="{Binding HasImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                            <Path HorizontalAlignment="Center"
                                                  Width="18"
                                                  Height="18"
                                                  Data="M 9 2 V 16 M 2 9 H 16"
                                                  Stroke="{StaticResource Deck.Brush.Text.Primary}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Deck.Brush.Text.Primary}"
                                                       HorizontalAlignment="Center"
                                                       Text="이미지 드롭" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <StackPanel Margin="12,0,0,0"
                                            VerticalAlignment="Center">
                                    <Button Command="{Binding ChooseImageCommand}"
                                            Style="{StaticResource Deck.ImageActionButtonStyle}"
                                            Content="이미지 선택" />
                                    <Button Margin="0,8,0,0"
                                            Command="{Binding RemoveImageCommand}"
                                            Style="{StaticResource Deck.ImageActionButtonStyle}"
                                            Content="이미지 제거"
                                            IsEnabled="{Binding HasImage}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="3"
                           Margin="0,4,0,0"
                           Style="{StaticResource Deck.ErrorTextStyle}"
                           Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap" />
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="1"
              Style="{StaticResource Deck.FooterActionsGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Command="{Binding DeleteCommand}"
                    Style="{StaticResource Deck.DangerFooterButtonStyle}"
                    Content="삭제"
                    IsEnabled="{Binding CanDelete}" />
            <Button Grid.Column="2"
                    Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource Deck.FooterButtonStyle}"
                    Content="취소" />
            <Button Grid.Column="3"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource Deck.PrimaryFooterButtonStyle}"
                    Content="저장" />
        </Grid>
    </Grid>
</UserControl>
