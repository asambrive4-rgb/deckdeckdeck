<UserControl x:Class="DeckDeckDeck.App.Views.SnippetEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:DeckDeckDeck.App.Views.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 카드 1: 기본 정보 -->
                <Border Style="{StaticResource Deck.InfoPanelBorderStyle}"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Style="{StaticResource Deck.FieldGroupStyle}">
                            <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="슬롯 명" />
                            <TextBox Style="{StaticResource Deck.TextBoxStyle}"
                                     Text="{Binding SnippetTitle, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Deck.FieldGroupSpacedStyle}">
                            <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="실행 타입" />
                            <UniformGrid Columns="3">
                                <RadioButton Content="문구 붙여넣기"
                                             GroupName="SnippetActionType"
                                             IsChecked="{Binding IsPasteTextAction, Mode=TwoWay}"
                                             Style="{StaticResource Deck.ActionTypeToggleStyle}" />
                                <RadioButton Content="파일/바로 가기 실행"
                                             GroupName="SnippetActionType"
                                             IsChecked="{Binding IsLaunchFileAction, Mode=TwoWay}"
                                             Style="{StaticResource Deck.ActionTypeToggleStyle}" />
                                <RadioButton Content="웹 주소 열기"
                                             GroupName="SnippetActionType"
                                             IsChecked="{Binding IsLaunchUrlAction, Mode=TwoWay}"
                                             Style="{StaticResource Deck.ActionTypeToggleStyle}" />
                                <RadioButton Content="음악/미디어 제어"
                                             GroupName="SnippetActionType"
                                             IsChecked="{Binding IsMediaAction, Mode=TwoWay}"
                                             Style="{StaticResource Deck.ActionTypeToggleStyle}" />
                                <RadioButton Content="터미널 명령 실행"
                                             GroupName="SnippetActionType"
                                             IsChecked="{Binding IsTerminalCommandAction, Mode=TwoWay}"
                                             Style="{StaticResource Deck.ActionTypeToggleStyle}" />
                                <RadioButton Content="타이머 실행"
                                             GroupName="SnippetActionType"
                                             IsChecked="{Binding IsTimerAction, Mode=TwoWay}"
                                             Style="{StaticResource Deck.ActionTypeToggleStyle}" />
                            </UniformGrid>
                            <RadioButton Margin="0,2,0,0"
                                         Content="Android 원격설치 (태블릿 4 · 폰 5 · 워치 6)"
                                         GroupName="SnippetActionType"
                                         IsChecked="{Binding IsRemoteInstallAction, Mode=TwoWay}"
                                         Style="{StaticResource Deck.ActionTypeToggleStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 카드 2: 상세 설정 -->
                <Border Grid.Row="1"
                        Style="{StaticResource Deck.InfoPanelBorderStyle}"
                        Margin="0,0,0,12">
                    <Grid>
                        <!-- 붙여넣을 문구 -->
                        <StackPanel Style="{StaticResource Deck.FieldGroupStyle}"
                                    Visibility="{Binding IsPasteTextAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="붙여넣을 문구" />
                            <TextBox MinHeight="80"
                                     MaxHeight="260"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     Style="{StaticResource Deck.TextBoxStyle}"
                                     Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                            <TextBlock Margin="0,12,0,6"
                                       Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="붙여넣기 방식" />
                            <ComboBox ItemsSource="{Binding PasteShortcutModeOptions}"
                                      SelectedValue="{Binding PasteShortcutMode, Mode=TwoWay}"
                                      SelectedValuePath="Mode"
                                      DisplayMemberPath="Label"
                                      Style="{StaticResource Deck.ComboBoxStyle}" />
                        </StackPanel>

                        <!-- 파일/바로 가기 실행 -->
                        <StackPanel Style="{StaticResource Deck.FieldGroupStyle}"
                                    Visibility="{Binding IsLaunchFileAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="파일 동작" />
                            <ComboBox ItemsSource="{Binding FileActionModeOptions}"
                                      SelectedValue="{Binding SelectedFileActionMode, Mode=TwoWay}"
                                      SelectedValuePath="Mode"
                                      DisplayMemberPath="Label"
                                      Style="{StaticResource Deck.ComboBoxStyle}" />
                            <TextBlock Margin="0,10,0,6"
                                       Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="{Binding FilePathLabel}" />
                            <TextBox Style="{StaticResource Deck.TextBoxStyle}"
                                     Text="{Binding LaunchPath, UpdateSourceTrigger=PropertyChanged}" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Command="{Binding ChooseLaunchFileCommand}"
                                        Style="{StaticResource Deck.ImageActionButtonStyle}"
                                        Content="{Binding FilePickerButtonText}" />
                                <Button Margin="8,0,0,0"
                                        Command="{Binding ChooseLaunchFolderCommand}"
                                        Style="{StaticResource Deck.ImageActionButtonStyle}"
                                        Content="폴더 선택"
                                        Visibility="{Binding IsFileLaunchMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Margin="8,0,0,0"
                                        Command="{Binding ChooseInstalledAppCommand}"
                                        Style="{StaticResource Deck.ImageActionButtonStyle}"
                                        Content="설치된 앱 선택"
                                        Visibility="{Binding IsFileLaunchMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </WrapPanel>
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{StaticResource Deck.Brush.Text.Secondary}"
                                       Text="직전에 사용하던 탐색기 또는 파일 붙여넣기를 지원하는 앱에 전달합니다."
                                       TextWrapping="Wrap"
                                       Visibility="{Binding IsFilePasteMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- 웹 주소 열기 -->
                        <StackPanel Style="{StaticResource Deck.FieldGroupStyle}"
                                    Visibility="{Binding IsLaunchUrlAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="열 웹페이지 주소" />
                            <TextBox Style="{StaticResource Deck.TextBoxStyle}"
                                     Text="{Binding LaunchUrl, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- 음악/미디어 제어 -->
                        <StackPanel Style="{StaticResource Deck.FieldGroupStyle}"
                                    Visibility="{Binding IsMediaAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="제어 대상" />
                            <ComboBox ItemsSource="{Binding MediaProviderOptions}"
                                      SelectedValue="{Binding SelectedMediaProvider, Mode=TwoWay}"
                                      SelectedValuePath="Provider"
                                      DisplayMemberPath="Label"
                                      Style="{StaticResource Deck.ComboBoxStyle}" />
                            <TextBlock Margin="0,10,0,6"
                                       Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="미디어 명령" />
                            <ComboBox ItemsSource="{Binding MediaCommandOptions}"
                                      SelectedValue="{Binding SelectedMediaCommand, Mode=TwoWay}"
                                      SelectedValuePath="Command"
                                      DisplayMemberPath="Label"
                                      Style="{StaticResource Deck.ComboBoxStyle}" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{StaticResource Deck.Brush.Text.Secondary}"
                                       Text="{Binding SpotifyMediaConnectionNotice}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding ShowSpotifyMediaConnectionNotice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- 터미널 명령 실행 -->
                        <StackPanel Style="{StaticResource Deck.FieldGroupStyle}"
                                    Visibility="{Binding IsTerminalCommandAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="빠른 설정 프리셋" />
                            
                            <!-- 2x2 스마트 프리셋 키캡 버튼 (DPI 및 폰트 크기 변경에 따른 잘림 방지 Grid 레이아웃) -->
                            <Grid Margin="0,4,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- (Row 0, Col 0): 1. 화면 끄기 -->
                                <Button Grid.Row="0" Grid.Column="0"
                                        Command="{Binding SelectTurnOffDisplayPresetCommand}">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource Deck.TerminalPresetButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTurnOffDisplayPresetActive}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Deck.Brush.Brand.Accent}" />
                                                    <Setter Property="Background" Value="#FAF6F0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Path HorizontalAlignment="Center" Width="16" Height="14" Stretch="Uniform"
                                              Data="{StaticResource Deck.Geometry.Monitor}">
                                            <Path.Style>
                                                <Style TargetType="{x:Type Path}">
                                                    <Setter Property="Stroke" Value="{StaticResource Deck.Brush.Text.Primary}" />
                                                    <Setter Property="StrokeThickness" Value="1.5" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTurnOffDisplayPresetActive}" Value="True">
                                                            <Setter Property="Stroke" Value="{StaticResource Deck.Brush.Brand.Accent}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock Grid.Row="1" Text="화면 끄기" FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" Margin="0,4,0,1"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource Deck.Brush.Text.Primary}"/>
                                        <TextBlock Grid.Row="2" Text="모니터 절전" FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource Deck.Brush.Text.Secondary}"/>
                                    </Grid>
                                </Button>

                                <!-- (Row 0, Col 2): 2. 블루투스 -->
                                <Button Grid.Row="0" Grid.Column="2"
                                        Command="{Binding SelectBluetoothPresetCommand}">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource Deck.TerminalPresetButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBluetoothPresetActive}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Deck.Brush.Brand.Accent}" />
                                                    <Setter Property="Background" Value="#FAF6F0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Path HorizontalAlignment="Center" Width="13" Height="15" Stretch="Uniform"
                                              Data="M 6.5,2 L 12,7.5 L 8,11.5 L 12,15.5 L 6.5,21 L 6.5,2 Z M 3,7.5 L 11,15.5 M 11,7.5 L 3,15.5">
                                            <Path.Style>
                                                <Style TargetType="{x:Type Path}">
                                                    <Setter Property="Stroke" Value="{StaticResource Deck.Brush.Text.Primary}" />
                                                    <Setter Property="StrokeThickness" Value="1.5" />
                                                    <Setter Property="Fill" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBluetoothPresetActive}" Value="True">
                                                            <Setter Property="Stroke" Value="{StaticResource Deck.Brush.Brand.Accent}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock Grid.Row="1" Text="블루투스" FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" Margin="0,4,0,1"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource Deck.Brush.Text.Primary}"/>
                                        <TextBlock Grid.Row="2" Text="오디오 연결/해제" FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource Deck.Brush.Text.Secondary}"/>
                                    </Grid>
                                </Button>

                                <!-- (Row 2, Col 0): 3. 무선 ADB -->
                                <Button Grid.Row="2" Grid.Column="0"
                                        Command="{Binding SelectAdbPairingPresetCommand}">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource Deck.TerminalPresetButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAdbPairingPresetActive}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Deck.Brush.Brand.Accent}" />
                                                    <Setter Property="Background" Value="#FAF6F0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Path HorizontalAlignment="Center" Width="14" Height="14" Stretch="Uniform"
                                              Data="{StaticResource Deck.Geometry.Bolt}">
                                            <Path.Style>
                                                <Style TargetType="{x:Type Path}">
                                                    <Setter Property="Stroke" Value="{StaticResource Deck.Brush.Text.Primary}" />
                                                    <Setter Property="StrokeThickness" Value="1.5" />
                                                    <Setter Property="Fill" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAdbPairingPresetActive}" Value="True">
                                                            <Setter Property="Stroke" Value="{StaticResource Deck.Brush.Brand.Accent}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock Grid.Row="1" Text="무선 ADB" FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" Margin="0,4,0,1"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource Deck.Brush.Text.Primary}"/>
                                        <TextBlock Grid.Row="2" Text="디버깅 연결" FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource Deck.Brush.Text.Secondary}"/>
                                    </Grid>
                                </Button>

                                <!-- (Row 2, Col 2): 4. 직접 입력 -->
                                <Button Grid.Row="2" Grid.Column="2"
                                        Command="{Binding SelectCustomTerminalCommandPresetCommand}">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource Deck.TerminalPresetButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCustomTerminalCommandActive}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Deck.Brush.Brand.Accent}" />
                                                    <Setter Property="Background" Value="#FAF6F0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Path HorizontalAlignment="Center" Width="15" Height="14" Stretch="Uniform"
                                              Data="{StaticResource Deck.Geometry.Terminal}">
                                            <Path.Style>
                                                <Style TargetType="{x:Type Path}">
                                                    <Setter Property="Stroke" Value="{StaticResource Deck.Brush.Text.Primary}" />
                                                    <Setter Property="StrokeThickness" Value="1.5" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCustomTerminalCommandActive}" Value="True">
                                                            <Setter Property="Stroke" Value="{StaticResource Deck.Brush.Brand.Accent}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock Grid.Row="1" Text="직접 입력" FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" Margin="0,4,0,1"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource Deck.Brush.Text.Primary}"/>
                                        <TextBlock Grid.Row="2" Text="커스텀 명령" FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource Deck.Brush.Text.Secondary}"/>
                                    </Grid>
                                </Button>
                            </Grid>

                            <!-- 화면 끄기 요약 안내 카드 (DPI/창폭 대응 완벽 잘림 방지) -->
                            <Border Margin="0,2,0,8"
                                    Padding="12,10"
                                    CornerRadius="12"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource Deck.Brush.Line.Soft}"
                                    Background="{StaticResource Deck.Brush.Background.Surface}"
                                    Visibility="{Binding IsTurnOffDisplayPresetActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                        <Path DockPanel.Dock="Left"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Data="{StaticResource Deck.Geometry.Monitor}"
                                              Stroke="{StaticResource Deck.Brush.Brand.Accent}"
                                              StrokeThickness="1.5"
                                              Margin="0,0,6,0"
                                              VerticalAlignment="Center"/>
                                        <TextBlock FontWeight="SemiBold"
                                                   FontSize="12.5"
                                                   Foreground="{StaticResource Deck.Brush.Text.Primary}"
                                                   TextWrapping="Wrap"
                                                   Text="화면 끄기 모드가 적용되었습니다" />
                                    </DockPanel>
                                    <TextBlock Margin="0,2,0,2"
                                               FontSize="11.5"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource Deck.Brush.Text.Secondary}"
                                               Text="• 실행 시 앱 창이 즉시 닫히며 모니터 화면만 꺼집니다." />
                                    <TextBlock Margin="0,2,0,2"
                                               FontSize="11.5"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource Deck.Brush.Text.Secondary}"
                                               Text="• PC 본체와 핫스팟, Wi-Fi 및 백그라운드 작업은 유지됩니다." />
                                    <TextBlock Margin="0,2,0,6"
                                               FontSize="11.5"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource Deck.Brush.Text.Secondary}"
                                               Text="• 마우스를 움직이거나 키를 누르면 화면이 다시 켜집니다." />
                                    <Button Command="{Binding ToggleAdvancedTerminalSettingsCommand}"
                                            HorizontalAlignment="Left"
                                            Padding="10,4"
                                            MinHeight="28"
                                            Width="Auto"
                                            FontSize="11.5"
                                            Style="{StaticResource Deck.SecondaryButtonStyle}"
                                            Content="고급 설정 열기/닫기 ⌵" />
                                </StackPanel>
                            </Border>

                            <!-- 블루투스 오디오 연결/해제 카드 -->
                            <Border Margin="0,2,0,8"
                                    Style="{StaticResource Deck.InfoPanelBorderStyle}"
                                    Visibility="{Binding IsBluetoothPresetActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{StaticResource Deck.Brush.Text.Primary}"
                                               Text="블루투스 오디오 빠른 연결/해제" />
                                    <TextBlock Margin="0,4,0,8"
                                               Foreground="{StaticResource Deck.Brush.Text.Secondary}"
                                               Text="외부 프로그램이나 관리자 권한 창 없이 윈도우 내장 블루투스 오디오를 즉시 연결하거나 해제합니다."
                                               TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                               Text="동작" />
                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                        <RadioButton Content="연결 (ON)"
                                                     IsChecked="{Binding IsBluetoothConnectAction, Mode=TwoWay}"
                                                     Style="{StaticResource Deck.ActionTypeToggleStyle}" />
                                        <RadioButton Content="연결 해제 (OFF)"
                                                     IsChecked="{Binding IsBluetoothDisconnectAction, Mode=TwoWay}"
                                                     Style="{StaticResource Deck.ActionTypeToggleStyle}" />
                                    </UniformGrid>
                                    <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                               Text="대상 기기 (MAC 주소 또는 기기 이름)" />
                                    <TextBox FontFamily="Cascadia Code, Consolas"
                                             Style="{StaticResource Deck.TextBoxStyle}"
                                             Text="{Binding BluetoothTarget, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="예: E4:92:82:82:D5:9B 또는 WH-1000XM5" />
                                    <!-- 감지된 기기 아이콘 미리보기 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                Visibility="{Binding HasDetectedAudioDeviceIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border Width="26" Height="26" CornerRadius="6"
                                                Background="{StaticResource Deck.Brush.Background.SurfaceSoft}"
                                                BorderBrush="{StaticResource Deck.Brush.Line.Soft}"
                                                BorderThickness="1"
                                                Margin="0,0,8,0">
                                            <Image Source="{Binding DetectedAudioDeviceIconResourcePath, Converter={StaticResource Deck.CachedImageSourceConverter}, ConverterParameter=32}"
                                                   Stretch="Uniform" Margin="2" />
                                        </Border>
                                        <TextBlock Text="전용 기기 프리셋 아이콘이 슬롯에 자동 적용됩니다" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Deck.Brush.Text.Secondary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Command="{Binding ChooseBluetoothDeviceCommand}"
                                                Style="{StaticResource Deck.ImageActionButtonStyle}"
                                                Content="페어링된 기기 선택" />
                                        <Button Margin="8,0,0,0"
                                                Command="{Binding ToggleAdvancedTerminalSettingsCommand}"
                                                Padding="10,4"
                                                MinHeight="28"
                                                Width="Auto"
                                                FontSize="11.5"
                                                Style="{StaticResource Deck.SecondaryButtonStyle}"
                                                Content="고급 설정 열기/닫기 ⌵" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- ADB 무선 디버깅 카드 -->
                            <Border Margin="0,2,0,8"
                                    Style="{StaticResource Deck.InfoPanelBorderStyle}"
                                    Visibility="{Binding IsAdbPairingPresetActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{StaticResource Deck.Brush.Text.Primary}"
                                               Text="무선 디버깅 연결" />
                                    <TextBlock Margin="0,4,0,8"
                                               Foreground="{StaticResource Deck.Brush.Text.Secondary}"
                                               Text="이 슬롯에 쓸 기기 IP를 입력하세요. 저장 후 실행하면 포트만 입력하는 창이 뜨고 adb connect 합니다."
                                               TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                               Text="기기 IP 주소" />
                                    <TextBox FontFamily="Cascadia Code, Consolas"
                                             Style="{StaticResource Deck.TextBoxStyle}"
                                             Text="{Binding AdbDeviceIp, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="예: 10.42.17.83" />
                                    <Button Command="{Binding ToggleAdvancedTerminalSettingsCommand}"
                                            HorizontalAlignment="Left"
                                            Margin="0,8,0,0"
                                            Padding="10,4"
                                            MinHeight="28"
                                            Width="Auto"
                                            FontSize="11.5"
                                            Style="{StaticResource Deck.SecondaryButtonStyle}"
                                            Content="고급 설정 열기/닫기 ⌵" />
                                </StackPanel>
                            </Border>

                            <!-- 고급 / 직접 입력 터미널 설정 (점진적 공개) -->
                            <StackPanel Visibility="{Binding ShowAdvancedTerminalSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                           Margin="0,6,0,0"
                                           Text="실행 셸" />
                                <ComboBox ItemsSource="{Binding TerminalShellOptions}"
                                          SelectedValue="{Binding SelectedTerminalShell, Mode=TwoWay}"
                                          SelectedValuePath="Shell"
                                          DisplayMemberPath="Label"
                                          Style="{StaticResource Deck.ComboBoxStyle}" />
                                <CheckBox Margin="0,10,0,0"
                                          Content="관리자 권한으로 실행"
                                          Style="{StaticResource Deck.CheckBoxStyle}"
                                          IsChecked="{Binding RunAsAdministrator}" />
                                <CheckBox Margin="0,8,0,0"
                                          Content="터미널 창으로 열기"
                                          Style="{StaticResource Deck.CheckBoxStyle}"
                                          IsChecked="{Binding OpenTerminalWindow}" />
                                <TextBlock Margin="0,12,0,0"
                                           Style="{StaticResource Deck.FieldLabelTextStyle}"
                                           Text="작업 폴더 (선택)" />
                                <TextBox Style="{StaticResource Deck.TextBoxStyle}"
                                         Text="{Binding TerminalWorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Margin="0,8,0,8"
                                        HorizontalAlignment="Left"
                                        Command="{Binding ChooseTerminalWorkingDirectoryCommand}"
                                        Style="{StaticResource Deck.ImageActionButtonStyle}"
                                        Content="폴더 선택" />
                                <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                           Text="터미널 명령" />
                                <TextBox MinHeight="80"
                                         MaxHeight="260"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         FontFamily="Cascadia Code, Consolas"
                                         Style="{StaticResource Deck.TextBoxStyle}"
                                         Text="{Binding TerminalCommand, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{StaticResource Deck.Brush.Text.Secondary}"
                                           Text="신뢰하는 명령만 저장하고 실행하세요. 명령을 비우면 작업 폴더에서 셸만 엽니다. 관리자 권한 실행 시 Windows 확인창이 표시될 수 있습니다."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Android 원격설치 (태블릿 4 / 폰 5 / 워치 6) -->
                        <StackPanel Style="{StaticResource Deck.FieldGroupStyle}"
                                    Visibility="{Binding IsRemoteInstallAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="1. 대상 기기 종류 (태블릿 4 · 폰 5 · 워치 6)" />

                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 태블릿 (4) -->
                                <Button Grid.Column="0"
                                        Command="{Binding SelectRemoteInstallTabletCommand}">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource Deck.TerminalPresetButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRemoteInstallTabletSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Deck.Brush.Brand.Accent}" />
                                                    <Setter Property="Background" Value="#FAF6F0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="태블릿" FontSize="12.5" FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource Deck.Brush.Text.Primary}" />
                                        <TextBlock Text="슬롯 4 · ≥600dp" FontSize="10"
                                                   Margin="0,2,0,0"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource Deck.Brush.Text.Secondary}" />
                                    </StackPanel>
                                </Button>

                                <!-- 폰 (5) -->
                                <Button Grid.Column="2"
                                        Command="{Binding SelectRemoteInstallPhoneCommand}">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource Deck.TerminalPresetButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRemoteInstallPhoneSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Deck.Brush.Brand.Accent}" />
                                                    <Setter Property="Background" Value="#FAF6F0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="폰" FontSize="12.5" FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource Deck.Brush.Text.Primary}" />
                                        <TextBlock Text="슬롯 5 · 스마트폰" FontSize="10"
                                                   Margin="0,2,0,0"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource Deck.Brush.Text.Secondary}" />
                                    </StackPanel>
                                </Button>

                                <!-- 워치 (6) -->
                                <Button Grid.Column="4"
                                        Command="{Binding SelectRemoteInstallWatchCommand}">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource Deck.TerminalPresetButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRemoteInstallWatchSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Deck.Brush.Brand.Accent}" />
                                                    <Setter Property="Background" Value="#FAF6F0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="워치" FontSize="12.5" FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource Deck.Brush.Text.Primary}" />
                                        <TextBlock Text="슬롯 6 · Wear OS" FontSize="10"
                                                   Margin="0,2,0,0"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource Deck.Brush.Text.Secondary}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="2. Android 프로젝트 폴더" />
                            <TextBox FontFamily="Cascadia Code, Consolas"
                                     Style="{StaticResource Deck.TextBoxStyle}"
                                     Text="{Binding RemoteInstallProjectPath, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="예: C:\Users\joajo\AndroidStudioProjects\WatchYouDoin" />
                            <WrapPanel Margin="0,8,0,10">
                                <Button Command="{Binding ChooseRemoteInstallProjectFolderCommand}"
                                        Style="{StaticResource Deck.ImageActionButtonStyle}"
                                        Content="프로젝트 폴더 선택" />
                                <Button Margin="8,0,0,0"
                                        Command="{Binding RescanRemoteInstallModulesCommand}"
                                        Style="{StaticResource Deck.SecondaryButtonStyle}"
                                        Padding="10,4"
                                        MinHeight="28"
                                        Content="모듈 다시 스캔" />
                                <Button Margin="8,0,0,0"
                                        Command="{Binding ApplyBatch456RemoteInstallSlotsCommand}"
                                        Style="{StaticResource Deck.SecondaryButtonStyle}"
                                        Padding="10,4"
                                        MinHeight="28"
                                        ToolTip="현재 프로젝트 기준으로 이 카테고리의 슬롯 4(태블릿)·5(폰)·6(워치)을 한 번에 저장합니다."
                                        Content="슬롯 4·5·6 한 번에 배치 ⚡" />
                            </WrapPanel>

                            <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="3. 빌드할 Android 앱 모듈" />
                            <ComboBox Margin="0,0,0,6"
                                      ItemsSource="{Binding RemoteInstallModuleOptions}"
                                      SelectedValue="{Binding RemoteInstallModule, Mode=TwoWay}"
                                      SelectedValuePath="ModuleName"
                                      DisplayMemberPath="DisplayLabel"
                                      Style="{StaticResource Deck.ComboBoxStyle}"
                                      Visibility="{Binding HasRemoteInstallModuleOptions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBox FontFamily="Cascadia Code, Consolas"
                                     Style="{StaticResource Deck.TextBoxStyle}"
                                     Text="{Binding RemoteInstallModule, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="예: :phone:android 또는 :wear:android 또는 :app" />

                            <CheckBox Margin="0,10,0,8"
                                      Content="설치 완료 후 앱 자동 실행 (assembleDebug 빌드 후 실행)"
                                      Style="{StaticResource Deck.CheckBoxStyle}"
                                      IsChecked="{Binding RemoteInstallLaunchAfterInstall}" />

                            <!-- 연결된 ADB 기기 4단계 분류 미리보기 카드 -->
                            <Border Margin="0,4,0,6"
                                    Padding="12,10"
                                    CornerRadius="12"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource Deck.Brush.Line.Soft}"
                                    Background="{StaticResource Deck.Brush.Background.Surface}">
                                <StackPanel>
                                    <TextBlock FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Deck.Brush.Text.Primary}"
                                               Text="실시간 ADB 기기 분류 상태 (특성 · 화면 dp · 모델명)" />
                                    <TextBlock Margin="0,4,0,8"
                                               FontSize="11.5"
                                               Foreground="{StaticResource Deck.Brush.Text.Secondary}"
                                               Text="{Binding RemoteInstallConnectedDevicesSummary}"
                                               TextWrapping="Wrap" />
                                    <WrapPanel>
                                        <Button Command="{Binding RefreshRemoteInstallDevicesCommand}"
                                                Padding="10,4"
                                                MinHeight="26"
                                                FontSize="11.5"
                                                Style="{StaticResource Deck.SecondaryButtonStyle}"
                                                Content="연결 기기 새로고침 ↻" />
                                        <Button Margin="8,0,0,0"
                                                Command="{Binding ToggleAdvancedRemoteInstallSettingsCommand}"
                                                Padding="10,4"
                                                MinHeight="26"
                                                FontSize="11.5"
                                                Style="{StaticResource Deck.SecondaryButtonStyle}"
                                                Content="고급: 특정 IP/시리얼 고정 ⌵" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- 고급: 특정 기기 IP/시리얼 필터 -->
                            <StackPanel Visibility="{Binding ShowAdvancedRemoteInstallSettings, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                           Text="특정 기기 IP 또는 시리얼 고정 (비워두면 기기 종류로 자동 매칭)" />
                                <TextBox FontFamily="Cascadia Code, Consolas"
                                         Style="{StaticResource Deck.TextBoxStyle}"
                                         Text="{Binding RemoteInstallTargetDevice, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="비워두면 연결된 태블릿/폰/워치 중 해당 종류 기기에 자동 설치합니다." />
                                <ItemsControl Margin="0,6,0,0"
                                              ItemsSource="{Binding CategoryAdbIpHints}"
                                              Visibility="{Binding HasCategoryAdbIpHints, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,6,6"
                                                    Padding="8,3"
                                                    MinHeight="24"
                                                    FontSize="11"
                                                    Style="{StaticResource Deck.SecondaryButtonStyle}"
                                                    Command="{Binding DataContext.ApplyAdbIpHintCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding IpAddress}"
                                                    Content="{Binding DisplayLabel}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 카드 3: 기타 옵션 -->
                <Border Grid.Row="2"
                        Style="{StaticResource Deck.InfoPanelBorderStyle}"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Style="{StaticResource Deck.FieldGroupStyle}">
                            <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="설명" />
                            <TextBox MinHeight="46"
                                     MaxHeight="80"
                                     AcceptsReturn="True"
                                     Style="{StaticResource Deck.TextBoxStyle}"
                                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                        <!-- 타이머 실행 -->
                        <StackPanel Style="{StaticResource Deck.FieldGroupStyle}"
                                    Visibility="{Binding IsTimerAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="⏱️ 타이머 실행 설정" />
                            <TextBlock Text="이 슬롯을 클릭하면 타이머 시간(분/초)을 선택하는 팝업이 표시되며 백그라운드 카운트다운이 즉시 시작됩니다."
                                       Foreground="{StaticResource Deck.Brush.Text.Primary}"
                                       FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <CheckBox Margin="0,12,0,12"
                                  Content="이 슬롯 사용"
                                  Style="{StaticResource Deck.CheckBoxStyle}"
                                  IsChecked="{Binding IsSlotEnabled}" />

                        <StackPanel Style="{StaticResource Deck.FieldGroupStyle}">
                            <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                       Text="이미지" />
                            <DockPanel LastChildFill="False">
                                <Border AllowDrop="True"
                                        DragOver="ImageDropTarget_DragOver"
                                        Drop="ImageDropTarget_Drop"
                                        Style="{StaticResource Deck.ThumbnailFrameBorderStyle}">
                                    <Grid>
                                        <Image Source="{Binding ThumbnailPath, IsAsync=True, Converter={StaticResource Deck.CachedImageSourceConverter}, ConverterParameter=96}"
                                               IsHitTestVisible="False"
                                               Stretch="Uniform" />
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.45"
                                                    IsHitTestVisible="False"
                                                    Visibility="{Binding HasImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                            <Path HorizontalAlignment="Center"
                                                  Width="18"
                                                  Height="18"
                                                  Data="M 9 2 V 16 M 2 9 H 16"
                                                  Stroke="{StaticResource Deck.Brush.Text.Primary}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Deck.Brush.Text.Primary}"
                                                       HorizontalAlignment="Center"
                                                       Text="이미지 드롭" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <StackPanel Margin="12,0,0,0"
                                            VerticalAlignment="Center">
                                    <Button Command="{Binding ChooseImageCommand}"
                                            Style="{StaticResource Deck.ImageActionButtonStyle}"
                                            Content="이미지 선택" />
                                    <Button Margin="0,8,0,0"
                                            Command="{Binding RemoveImageCommand}"
                                            Style="{StaticResource Deck.ImageActionButtonStyle}"
                                            Content="이미지 제거"
                                            IsEnabled="{Binding HasImage}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 카드 4: 슬롯 복사/이동 -->
                <Border Grid.Row="3"
                        Style="{StaticResource Deck.InfoPanelBorderStyle}"
                        Margin="0,0,0,12"
                        IsEnabled="{Binding CanTransfer}">
                    <StackPanel Style="{StaticResource Deck.FieldGroupStyle}">
                        <TextBlock Style="{StaticResource Deck.FieldLabelTextStyle}"
                                   Text="슬롯 복사/이동" />
                        <ComboBox ItemsSource="{Binding TransferTargetSlots}"
                                  SelectedItem="{Binding SelectedTransferTarget}"
                                  DisplayMemberPath="Label"
                                  Style="{StaticResource Deck.ComboBoxStyle}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Command="{Binding CopySnippetCommand}"
                                    Style="{StaticResource Deck.ImageActionButtonStyle}"
                                    Content="슬롯 복사" />
                            <Button Grid.Column="2"
                                    Command="{Binding MoveSnippetCommand}"
                                    Style="{StaticResource Deck.ImageActionButtonStyle}"
                                    Content="슬롯 이동" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="4"
                           Margin="0,4,0,0"
                           Style="{StaticResource Deck.ErrorTextStyle}"
                           Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap" />
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="1"
              Style="{StaticResource Deck.FooterActionsGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Command="{Binding DeleteCommand}"
                    Style="{StaticResource Deck.DangerFooterButtonStyle}"
                    Content="삭제"
                    IsEnabled="{Binding CanDelete}" />
            <Button Grid.Column="2"
                    Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource Deck.FooterButtonStyle}"
                    Content="취소" />
            <Button Grid.Column="3"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource Deck.PrimaryFooterButtonStyle}"
                    Content="저장" />
        </Grid>
    </Grid>
</UserControl>
