<Window x:Class="DeckDeckDeck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:DeckDeckDeck.App.Views"
        xmlns:navigation="clr-namespace:DeckDeckDeck.App.Views.Navigation"
        xmlns:viewModels="clr-namespace:DeckDeckDeck.App.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle, FallbackValue=DeckDeckDeck, TargetNullValue=DeckDeckDeck}"
        ShowInTaskbar="True"
        Width="440"
        Height="580"
        MinWidth="440"
        MinHeight="580"
        Style="{StaticResource Deck.MainWindowStyle}"
        ShowActivated="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="OnPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <!-- Crisp vector/ClearType rendering without BitmapCache rasterization blur -->
        <Style x:Key="Deck.ViewTransitionContainerStyle" TargetType="{x:Type Border}" />
        <DataTemplate DataType="{x:Type viewModels:HomeViewModel}">
            <Border Style="{StaticResource Deck.ViewTransitionContainerStyle}">
                <views:HomeView />
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:CategoryViewModel}">
            <Border Style="{StaticResource Deck.ViewTransitionContainerStyle}">
                <views:CategoryView />
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:CategoryEditViewModel}">
            <Border Style="{StaticResource Deck.ViewTransitionContainerStyle}">
                <views:CategoryEditView />
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SnippetEditViewModel}">
            <Border Style="{StaticResource Deck.ViewTransitionContainerStyle}">
                <views:SnippetEditView />
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:HotkeyListViewModel}">
            <Border Style="{StaticResource Deck.ViewTransitionContainerStyle}">
                <views:HotkeyListView />
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:HotkeyEditViewModel}">
            <Border Style="{StaticResource Deck.ViewTransitionContainerStyle}">
                <views:HotkeyEditView />
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <Border Style="{StaticResource Deck.ViewTransitionContainerStyle}">
                <views:SettingsView />
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Border Style="{StaticResource Deck.WindowFrameBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Deck.TopBarBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Command="{Binding TopBarBackCommand}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource Deck.TopBarBackButtonStyle}"
                                Visibility="{Binding ShowTopBarBackButton, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <TextBlock Grid.Column="1"
                                   Margin="8,0,12,0"
                                   Style="{StaticResource Deck.TopBarTitleTextStyle}"
                                   Text="{Binding TopBarTitle}"
                                   Visibility="{Binding ShowTopBarTitle, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <!-- 블루투스 기기명 및 배터리 표시 영역 -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"
                                    ToolTip="{Binding TopBarStatusToolTip}">
                            <!-- 기기명 (말줄임) -->
                            <TextBlock Style="{StaticResource Deck.TopBarStatusTextStyle}"
                                       MaxWidth="120"
                                       Text="{Binding TopBarDeviceName}" />

                            <!-- 배터리 뱃지 (배터리 정보가 있을 때만 표시) -->
                            <Border Visibility="{Binding HasTopBarBattery, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Margin="6,0,0,0"
                                    Padding="5,1,5,1"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Background" Value="{StaticResource Deck.Brush.Background.Surface}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Deck.Brush.Line.Soft}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTopBarBatteryLow}" Value="True">
                                                <Setter Property="Background" Value="#FFEEDD" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Deck.Brush.Brand.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- 배터리 미니 아이콘 -->
                                    <Path Width="11"
                                          Height="8"
                                          Stretch="Uniform"
                                          Margin="0,0,3,0"
                                          VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="{x:Type Path}">
                                                <Setter Property="Fill" Value="{StaticResource Deck.Brush.Text.Primary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTopBarBatteryLow}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource Deck.Brush.Brand.Accent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                        <Path.Data>
                                            <GeometryGroup>
                                                <RectangleGeometry Rect="0,0,10,7" RadiusX="1" RadiusY="1" />
                                                <RectangleGeometry Rect="10,2,1.5,3" RadiusX="0.5" RadiusY="0.5" />
                                            </GeometryGroup>
                                        </Path.Data>
                                    </Path>
                                    <!-- 배터리 잔량 텍스트 -->
                                    <TextBlock Text="{Binding TopBarBatteryText}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Foreground" Value="{StaticResource Deck.Brush.Text.Primary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTopBarBatteryLow}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Deck.Brush.Brand.Accent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Button Grid.Column="3"
                                Margin="0,0,8,0"
                                Command="{Binding TopBarSettingsCommand}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource Deck.TopBarSettingsButtonStyle}"
                                Visibility="{Binding ShowTopBarSettingsButton, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <StackPanel Grid.Column="4"
                                    Orientation="Horizontal"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Click="OnMinimizeButtonClick"
                                    Style="{StaticResource Deck.WindowControlButtonStyle}"
                                    Content="{StaticResource Deck.Geometry.Minimize}"
                                    ToolTip="최소화" />
                            <Button Click="OnMaximizeRestoreButtonClick"
                                    Style="{StaticResource Deck.WindowControlButtonStyle}"
                                    Content="{StaticResource Deck.Geometry.Maximize}"
                                    ToolTip="최대화/복원" />
                            <Button Click="OnCloseButtonClick"
                                    Style="{StaticResource Deck.CloseWindowControlButtonStyle}"
                                    Content="{StaticResource Deck.Geometry.Close}"
                                    ToolTip="닫기" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Style="{StaticResource Deck.AppContentBorderStyle}">
                    <navigation:CachingContentControl Content="{Binding CurrentViewModel}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
